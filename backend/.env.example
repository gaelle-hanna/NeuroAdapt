# Replace both placeholders with local values. See the Docker setup in README.md.
DATABASE_URL=mysql+pymysql://neuroadapt:CHANGE_ME@127.0.0.1:3306/neuroadapt?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Enable only for disposable local QA without SMTP.
DEV_RESET_LINKS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=neuroadapt@example.com
