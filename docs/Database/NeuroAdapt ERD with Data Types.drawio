        <mxCell id="constraint_note" parent="1" style="text;html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontColor=default;fontSize=12;align=left;verticalAlign=top;spacing=0;" value="Rules: Users.Email, ProfessionalProfiles.LicenseNumber and PasswordReset.TokenHash must be UNIQUE. Profile type must match Users.Role (Patient or Professional). Allow at most one active assignment for each PatientID + ProfessionalID pair; professional access requires an active assignment. Enforce with database constraints and backend checks." vertex="1">
          <mxGeometry height="65" width="1330" x="70" y="1163" as="geometry" />
        </mxCell>
