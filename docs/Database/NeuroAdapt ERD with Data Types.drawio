        <mxCell id="fk_note" parent="1" style="text;html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontColor=default;fontSize=12;align=left;verticalAlign=top;spacing=0;" value="FK references: PatientProfiles.PatientID and ProfessionalProfiles.ProfessionalID → Users.UserID; PasswordReset.UserID → Users.UserID; Medications.PatientID → PatientProfiles.PatientID; MedicationIntakes.MedicationID → Medications.MedicationID; PatientProfessionals.PatientID → PatientProfiles.PatientID; PatientProfessionals.ProfessionalID → ProfessionalProfiles.ProfessionalID." vertex="1">
